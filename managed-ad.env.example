# Copy to .env and replace every value before deployment.
# Keep .env out of Git and restrict it to the deployment administrator.

# Generate independently, for example: openssl rand -base64 32
ORG_PEER_VAULT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET

# First-run Console administrator. Existing accounts are not overwritten.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_ADMIN_PASSWORD

# Absolute paths on the Docker host. Both files are mounted read-only.
# The certificate SAN must cover the DNS name used in the agent ServerUrl.
CDAP_TLS_CERT=/absolute/path/to/fullchain.pem
CDAP_TLS_KEY=/absolute/path/to/private-key.pem
